# ==========================================
# V-Closet Environment Variables Example
# Copy this file to '.env' and fill in your values
# ==========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=V-Closet_Version_3.0
DB_USER=postgres
DB_PASSWORD=a

# Connection String mapped to ASP.NET Core (ConnectionStrings:MyCnn)
ConnectionStrings__MyCnn="Host=localhost;Port=5432;Database=V-Closet_Version_3.0;Username=postgres;Password=a"

# Photoroom API Configuration
PHOTOROOM_API_KEY=your_photoroom_api_key_here

# Cloud Storage Configuration (S3 / Viettel IDC Object Storage)
S3_SERVICE_URL=https://s3-hcm-r1.idc.viettel.com.vn
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_BUCKET_NAME=your_s3_bucket_name_here

